{
    "name": "spandrel/spandrel-src",
    "description": "Analyse and enforce architectural rules for your PHP application",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Spandrel\\Spandrel\\": "src/"
        }
    },
    "require": {
        "symfony/console": "^8.1",
        "nikic/php-parser": "^5.8",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/yaml": "^8.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Spandrel\\Spandrel\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    }
}
